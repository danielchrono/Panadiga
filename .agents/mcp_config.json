{
  "mcpServers": {
    "panadiga-tools": {
      "command": "cargo",
      "args": ["run", "--quiet", "--bin", "panadiga", "--", "mcp"],
      "env": {
        "PANADIGA_WORKSPACE_ROOT": "."
      }
    },
    "ghidra": {
      "command": "C:\\ghidra\\.venv\\Scripts\\ghidra-mcp.exe",
      "args": ["--ghidra-server", "http://127.0.0.1:8080/"]
    }
  }
}

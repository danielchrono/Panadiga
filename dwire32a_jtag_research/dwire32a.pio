.program dwire32a
.side_set 1 opt

; =========================================================================
; Panasonic DWire32A Synchronous Half-Duplex Bus Transceiver
; Clock: 1.0 MHz exact (4 SM cycles @ 4.0 MHz, 50% duty cycle)
; Setup: 250 ns, Hold: 500 ns
;
; Pin mapping:
; OUT / IN / SET / PINDIRS base: GP4 (SDATA)
; SIDE-SET base: GP3 (SCLK)
;
; Header Format in TX FIFO (Shift Right, 32-bit):
; Bits 7..0 : (bit_count - 1) -> loaded into X
; Bit 8     : Direction (1 = TX Write, 0 = RX Read) -> loaded into Y
; =========================================================================

.wrap_target
public start:
    pull block          side 0  ; Fetch 32-bit Header from TX FIFO into OSR
    out x, 8            side 0  ; Load (bit_count - 1) into X
    out y, 1            side 0  ; Load Direction flag (Bit 8) into Y
    jmp !y, rx_mode     side 0  ; If Y == 0, jump to receive mode

tx_mode:
    pull block          side 0  ; Fetch 32-bit DATA word into OSR
    set pindirs, 1      side 0  ; Set SDATA as OUTPUT
tx_loop:
    out pins, 1         side 0     ; 1 cycle (250ns): SCLK=0, drive SDATA (Setup window)
    nop                 side 1 [1] ; 2 cycles (500ns): SCLK=1 (Hold window, target samples on rising edge)
    jmp x--, tx_loop    side 0     ; 1 cycle (250ns): SCLK=0 (Total SCLK low = 500ns, 50% duty cycle)
    set pindirs, 0      side 0  ; End of TX: immediately release SDATA to High-Z (no bus contention)
    jmp start           side 0

rx_mode:
    set pindirs, 0      side 0 [1] ; Ensure SDATA is INPUT (Hi-Z) + turnaround delay (500ns)
rx_loop:
    nop                 side 1 [1] ; 2 cycles (500ns): SCLK=1 (Target drives SDATA)
    in pins, 1          side 0     ; 1 cycle (250ns): SCLK=0, sample SDATA into ISR on falling edge
    jmp x--, rx_loop    side 0     ; 1 cycle (250ns): SCLK=0 (Total SCLK low = 500ns, 50% duty cycle)
    push block          side 0  ; Push received word from ISR to RX FIFO for ARM host
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "dwire32a_types.h"

static inline void dwire32a_program_init(PIO pio, uint sm, uint offset, uint pin_sdata, uint pin_sclk) {
    pio_sm_config c = dwire32a_program_get_default_config(offset);

    // Map SDATA for OUT, IN, SET and PINDIRS
    sm_config_set_out_pins(&c, pin_sdata, 1);
    sm_config_set_in_pins(&c, pin_sdata);
    sm_config_set_set_pins(&c, pin_sdata, 1);

    // Map SCLK for SIDE-SET
    sm_config_set_sideset_pins(&c, pin_sclk);

    // Shift Right (LSB first), manual pull/push
    sm_config_set_out_shift(&c, true, false, 32);
    sm_config_set_in_shift(&c, true, false, 32);

    // Clock divider for exact 4.0 MHz SM clock (1 MHz bus clock @ 4 cycles/bit)
    float div = (float)clock_get_hz(clk_sys) / (float)DWIRE_SM_FREQ_HZ;
    sm_config_set_clkdiv(&c, div);

    // Route physical pins to PIO peripheral
    pio_gpio_init(pio, pin_sclk);
    pio_gpio_init(pio, pin_sdata);
    gpio_pull_up(pin_sdata);

    // Initial electrical state: SCLK = 0 (Output Low), SDATA = High-Z (Input with pull-up)
    pio_sm_set_pins_with_mask(pio, sm, 0, (1u << pin_sclk) | (1u << pin_sdata));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << pin_sclk), (1u << pin_sclk) | (1u << pin_sdata));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}

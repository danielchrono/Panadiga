#!/bin/sh
# Git Pre-Commit Hook: Blocks commits if any quality gate fails
echo "[Git Hook] Executing Panadiga pre-commit quality validation..."

if command -v python3 >/dev/null 2>&1; then
    python3 scripts/validate.py
elif command -v python >/dev/null 2>&1; then
    python scripts/validate.py
else
    echo "Python 3 not found! Aborting commit."
    exit 1
fi

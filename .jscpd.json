{
  "threshold": 0,
  "mode": "weak",
  "reporters": ["console", "json"],
  "output": "./.jscpd-report",
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/manuals_and_schematics/**",
    "**/firmware_and_images/**",
    "**/.git/**",
    "**/.github/**",
    "**/*.json",
    "**/*.svg",
    "**/*.png",
    "**/*.ico",
    "**/*.bin",
    "**/*.uf2",
    "**/*.pdf"
  ],
  "format": [
    "typescript",
    "javascript",
    "rust",
    "python",
    "c",
    "cpp",
    "css"
  ],
  "path": [
    "apps/desktop/src",
    "apps/desktop/src-tauri/src",
    "crates",
    "firmware/pico-p7501",
    "tools",
    "scripts"
  ]
}

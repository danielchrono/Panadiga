{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panasonic DMR-EH55 DIGA Engineering Suite",
  "version": "0.1.0",
  "identifier": "com.panasonic.diga.engineering",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Panasonic DMR-EH55 DIGA Engineering Suite",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
